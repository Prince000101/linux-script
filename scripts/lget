# ═══════════════════════════════════════════════════════════════════════════════
# HELPERS
# ═══════════════════════════════════════════════════════════════════════════════

get_categories() {
  local cats=()
  for entry in "${PKGS[@]}"; do
    IFS='|' read -r _ _ cat _ <<< "$entry"
    local found=false
    for c in "${cats[@]}"; do [ "$c" = "$cat" ] && found=true && break; done
    $found || cats+=("$cat")
  done
  echo "${cats[@]}"
}

get_pkgs_by_cat() {
  local cat="$1" out=()
  for entry in "${PKGS[@]}"; do
    IFS='|' read -r name desc cat2 _ <<< "$entry"
    [ "$cat2" = "$cat" ] && out+=("$entry")
  done
  echo "${out[@]}"
}

get_cat_count() {
  local cat="$1" count=0
  for entry in "${PKGS[@]}"; do
    IFS='|' read -r _ _ c _ <<< "$entry"
    [ "$c" = "$cat" ] && ((count++))
  done
  echo "$count"
}

find_pkg() {
  for entry in "${PKGS[@]}"; do
    IFS='|' read -r name _ _ _ <<< "$entry"
    [ "$name" = "$1" ] && echo "$entry" && return 0
  done
  return 1
}

is_installed() {
  local name="$1"
  local entry
  entry=$(find_pkg "$name") || return 1
  IFS='|' read -r _ _ _ src <<< "$entry"
  IFS=':' read -r stype sval <<< "$src"
  case "$stype" in
    apt)   dpkg -s "$sval" 2>/dev/null | grep -q "Status: install ok installed" ;;
    snap|snap-classic) snap list 2>/dev/null | grep -q "^$sval " ;;
    pip)   pip show "$sval" 2>/dev/null | grep -q "Name" ;;
    npm)   npm list -g "$sval" 2>/dev/null | grep -q "$sval" ;;
    script) command -v "$name" &>/dev/null ;;
    *) return 1 ;;
  esac
}

# ═══════════════════════════════════════════════════════════════════════════════
# INSTALL / REMOVE ENGINE
# ═══════════════════════════════════════════════════════════════════════════════

install_one() {
  local entry="$1"
  IFS='|' read -r name desc cat src <<< "$entry"
  IFS=':' read -r stype sval <<< "$src"

  echo ""
  echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo -e "${GREEN}Installing:${NC} $name"
  echo -e "${CYAN}Description:${NC} $desc"
  echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

  case "$stype" in
    apt)
      sudo apt install -y "$sval" 2>&1 | tail -3
      ;;
    snap)
      sudo snap install "$sval" 2>&1 | tail -1
      ;;
    snap-classic)
      sudo snap install "$sval" --classic 2>&1 | tail -1
      ;;
    pip)
      pip install "$sval" 2>&1 | tail -1
      ;;
    npm)
      npm install -g "$sval" 2>&1 | tail -1
      ;;
    script)
      case "$name" in
        chrome)
          wget -q --show-progress -O /tmp/chrome.deb "https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"
          sudo dpkg -i /tmp/chrome.deb 2>/dev/null; sudo apt install -f -y 2>&1 | tail -1 ;;
        brave)
          sudo apt install -y curl 2>/dev/null
          sudo curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg 2>/dev/null
          echo "deb [signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main" | sudo tee /etc/apt/sources.list.d/brave-browser-release.list >/dev/null
          sudo apt update && sudo apt install -y brave-browser 2>&1 | tail -1 ;;
        opera)
          wget -q --show-progress -O /tmp/opera.deb "https://download.opera.com/download/get/?partner=www&opsys=Linux"
          sudo dpkg -i /tmp/opera.deb 2>/dev/null; sudo apt install -f -y 2>&1 | tail -1 ;;
        vivaldi)
          wget -q --show-progress -O /tmp/vivaldi.deb "https://downloads.vivaldi.com/stable/vivaldi-stable_amd64.deb"
          sudo dpkg -i /tmp/vivaldi.deb 2>/dev/null; sudo apt install -f -y 2>&1 | tail -1 ;;
        tor-browser)
          sudo apt install -y torbrowser-launcher 2>&1 | tail -1 ;;
        discord)
          wget -q --show-progress -O /tmp/discord.deb "https://discord.com/api/download?platform=linux&format=deb"
          sudo dpkg -i /tmp/discord.deb 2>/dev/null; sudo apt install -f -y 2>&1 | tail -1 ;;
        zoom)
          wget -q --show-progress -O /tmp/zoom.deb "https://zoom.us/client/latest/zoom_amd64.deb"
          sudo dpkg -i /tmp/zoom.deb 2>/dev/null; sudo apt install -f -y 2>&1 | tail -1 ;;
        spotify)
          curl -sS https://download.spotify.com/debian/pubkey_6224F9941A8AA6D1.gpg | sudo gpg --dearmor --yes -o /etc/apt/trusted.gpg.d/spotify.gpg 2>/dev/null
          echo "deb http://repository.spotify.com stable non-free" | sudo tee /etc/apt/sources.list.d/spotify.list >/dev/null
          sudo apt update && sudo apt install -y spotify-client 2>&1 | tail -1 ;;
        signal)
          wget -qO- https://updates.signal.org/desktop/apt/keys.asc | sudo gpg --dearmor --yes -o /usr/share/keyrings/signal-desktop-keyring.gpg 2>/dev/null
          echo "deb [signed-by=/usr/share/keyrings/signal-desktop-keyring.gpg] https://updates.signal.org/desktop/apt xenial main" | sudo tee /etc/apt/sources.list.d/signal-xenial.list >/dev/null
          sudo apt update && sudo apt install -y signal-desktop 2>&1 | tail -1 ;;
        code)
          wget -q --show-progress -O /tmp/code.deb "https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-x64"
          sudo dpkg -i /tmp/code.deb 2>/dev/null; sudo apt install -f -y 2>&1 | tail -1 ;;
        nodejs)
          curl -fsSL https://deb.nodesource.com/setup_lts.x | sudo -E bash - 2>&1 | tail -1
          sudo apt install -y nodejs 2>&1 | tail -1 ;;
        docker)
          curl -fsSL https://get.docker.com | sh 2>&1 | tail -3
          sudo usermod -aG docker "$USER" 2>/dev/null
          echo -e "${YELLOW}  -> Log out & back in for Docker group to work.${NC}" ;;
        rust)
          curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y 2>&1 | tail -3
          echo -e "${YELLOW}  -> Run: source ~/.cargo/env${NC}" ;;
        dotnet)
          wget -q --show-progress -O /tmp/packages-microsoft-prod.deb https://packages.microsoft.com/config/ubuntu/22.04/packages-microsoft-prod.deb
          sudo dpkg -i /tmp/packages-microsoft-prod.deb 2>/dev/null
          sudo apt update && sudo apt install -y dotnet-sdk-8.0 2>&1 | tail -1 ;;
        terraform)
          wget -qO- https://apt.releases.hashicorp.com/gpg | sudo gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg 2>/dev/null
          echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | sudo tee /etc/apt/sources.list.d/hashicorp.list >/dev/null
          sudo apt update && sudo apt install -y terraform 2>&1 | tail -1 ;;
        heroic)
          wget -q --show-progress -O /tmp/heroic.deb "https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher/releases/latest/download/heroic_2.15.2_amd64.deb"
          sudo dpkg -i /tmp/heroic.deb 2>/dev/null; sudo apt install -f -y 2>&1 | tail -1 ;;
        minecraft)
          sudo apt install -y minecraft-launcher 2>&1 | tail -1 ;;
        foxitreader)
          wget -q --show-progress -O /tmp/foxit.deb "https://cdn01.foxitsoftware.com/pub/foxit/reader/desktop/linux/2.x/2.4/en_us/FoxitReader.2.4.5.0727.x64.deb"
          sudo dpkg -i /tmp/foxit.deb 2>/dev/null; sudo apt install -f -y 2>&1 | tail -1 ;;
        *)
          echo -e "${RED}  No custom installer for $name${NC}" ;;
      esac
      ;;
  esac
  echo ""
}

remove_one() {
  local entry="$1"
  IFS='|' read -r name _ _ src <<< "$entry"
  IFS=':' read -r stype sval <<< "$src"
  case "$stype" in
    apt)   sudo apt remove -y "$sval" 2>&1 | tail -1 ;;
    snap|snap-classic) sudo snap remove "$sval" 2>&1 | tail -1 ;;
    pip)   pip uninstall -y "$sval" 2>&1 | tail -1 ;;
    npm)   npm uninstall -g "$sval" 2>&1 | tail -1 ;;
    script) echo -e "${YELLOW}  $name was script-installed. Remove manually.${NC}" ;;
  esac
}

# ═══════════════════════════════════════════════════════════════════════════════
# INTERACTIVE UI
# ═══════════════════════════════════════════════════════════════════════════════

show_banner() {
  clear
  echo -e "${CYAN}┌─────────────────────────────────────────────────────────┐${NC}"
  echo -e "${GREEN}│               LGET - Linux Package Manager              │${NC}"
  echo -e "${CYAN}│          Chocolatey-style for Linux Mint ${NC}"
  echo -e "${CYAN}└─────────────────────────────────────────────────────────┘${NC}"
  echo ""
}

show_cat_menu() {
  local cat="$1"
  local entries=($(get_pkgs_by_cat "$cat"))
  local total=${#entries[@]}
  local cols=2
  local rows=$(( (total + cols - 1) / cols ))

  while true; do
    show_banner
    echo -e "${YELLOW}  Category:${NC} $cat  ${CYAN}[$total packages]${NC}"
    echo ""

    for i in $(seq 0 $((total - 1))); do
      IFS='|' read -r name desc _ _ <<< "${entries[$i]}"
      local mark=" "
      is_installed "$name" && mark="${GREEN}✓${NC}"
      printf "  %s %-2s ${CYAN}%-14s${NC} %-35s" "$mark" "[$((i+1))]" "$name" "$desc"
      # Print second column
      local j=$((i + rows))
      if [ "$j" -lt "$total" ]; then
        IFS='|' read -r name2 desc2 _ _ <<< "${entries[$j]}"
        local mark2=" "
        is_installed "$name2" && mark2="${GREEN}✓${NC}"
        printf "%s %-2s ${CYAN}%-14s${NC} %s" "$mark2" "[$((j+1))]" "$name2" "$desc2"
      fi
      echo ""
      [ "$((i % rows))" -eq $((rows - 1)) ] || [ "$i" -eq $((total - 1)) ] && [ "$j" -lt "$total" ] && echo "" # spacer between rows
      [ "$((i % rows))" -eq $((rows - 1)) ] || [ "$i" -eq $((total - 1)) ] && [ "$j" -ge "$total" ] && echo "" # spacer between rows
    done

    echo ""
    echo -e "${YELLOW}  Enter numbers to install (e.g. 1 3 5-8)${NC}"
    echo -e "  ${GREEN}[b]${NC} Back to categories  ${GREEN}[q]${NC} Quit"
    echo ""
    read -p "  Choice: " input

    [ "$input" = "q" ] && clear && exit 0
    [ "$input" = "b" ] && return

    # Parse selection: "1 3 5-8" → install those packages
    local selected=()
    for part in $input; do
      if echo "$part" | grep -qE '^[0-9]+-[0-9]+$'; then
        local start="${part%-*}" end="${part#*-}"
        for n in $(seq "$start" "$end"); do
          [ "$n" -ge 1 ] && [ "$n" -le "$total" ] && selected+=("$n")
        done
      elif [ "$part" -ge 1 ] 2>/dev/null && [ "$part" -le "$total" ] 2>/dev/null; then
        selected+=("$part")
      fi
    done

    if [ ${#selected[@]} -gt 0 ]; then
      local names=()
      for n in "${selected[@]}"; do
        IFS='|' read -r name _ _ _ <<< "${entries[$((n-1))]}"
        names+=("$name")
      done
      echo ""
      echo -e "${YELLOW}Installing:${NC} ${names[*]}"
      read -p "Proceed? [Y/n]: " confirm
      [[ "$confirm" =~ ^[nN] ]] && continue
      for n in "${selected[@]}"; do
        install_one "${entries[$((n-1))]}"
      done
      read -p "Press Enter..."
    fi
  done
}

show_main_menu() {
  local categories=($(get_categories))
  local cat_count=${#categories[@]}

  while true; do
    show_banner

    echo -e "${YELLOW}  Browse packages by category:${NC}"
    echo ""

    for i in $(seq 0 $((cat_count - 1))); do
      local c="${categories[$i]}"
      local cnt=$(get_cat_count "$c")
      printf "  [${GREEN}%d${NC}]  ${CYAN}%-22s${NC} ${YELLOW}(%d packages)${NC}\n" $((i+1)) "$c" "$cnt"
    done

    echo ""
    echo -e "  [${GREEN}s${NC}]  Search all packages"
    echo -e "  [${GREEN}i${NC}]  Show installed packages"
    echo -e "  [${GREEN}u${NC}]  System update & cleanup"
    echo -e "  [${GREEN}h${NC}]  Help & usage"
    echo -e "  [${GREEN}q${NC}]  Quit"
    echo ""
    read -p "  Choice: " choice

    case "$choice" in
      q|Q) clear; exit 0 ;;
      h|H) show_help; read -p "Press Enter..." ;;
      u|U) system_update; read -p "Press Enter..." ;;
      i|I) show_installed; read -p "Press Enter..." ;;
      s|S) interactive_search; read -p "Press Enter..." ;;
      *)
        if [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le "$cat_count" ] 2>/dev/null; then
          show_cat_menu "${categories[$((choice-1))]}"
        fi
        ;;
    esac
  done
}

show_installed() {
  show_banner
  echo -e "${YELLOW}  Installed Packages:${NC}"
  echo ""
  local count=0
  for entry in "${PKGS[@]}"; do
    IFS='|' read -r name desc _ _ <<< "$entry"
    if is_installed "$name"; then
      printf "  ${GREEN}✓${NC} ${CYAN}%-14s${NC} %s\n" "$name" "$desc"
      ((count++))
    fi
  done
  [ "$count" -eq 0 ] && echo "  No packages from the database are installed yet."
  echo ""
  echo -e "${YELLOW}  Total: $count installed${NC}"
}

interactive_search() {
  read -p "  Search: " query
  [ -z "$query" ] && return
  show_banner
  echo -e "${YELLOW}  Results for '$query':${NC}"
  echo ""
  local matches=0
  for entry in "${PKGS[@]}"; do
    IFS='|' read -r name desc cat _ <<< "$entry"
    if echo "$name $desc" | grep -qi "$query"; then
      local mark=" "
      is_installed "$name" && mark="${GREEN}✓${NC}"
      printf "  %s ${CYAN}%-14s${NC} %s  ${YELLOW}[%s]${NC}\n" "$mark" "$name" "$desc" "$cat"
      ((matches++))
    fi
  done
  [ "$matches" -eq 0 ] && echo "  No matches."
  echo ""
  echo -e "${YELLOW}  $matches matches${NC}"
  echo ""
  read -p "  Install any? (enter names, or blank): " install_names
  [ -z "$install_names" ] && return
  for name in $install_names; do
    entry=$(find_pkg "$name") && install_one "$entry"
  done
}

system_update() {
  show_banner
  echo -e "${YELLOW}  System Update${NC}"
  echo ""
  echo -e "${GREEN}[1/4]${NC} Updating APT package lists..."
  sudo apt update -qq
  echo -e "${GREEN}[2/4]${NC} Upgrading packages..."
  sudo apt upgrade -y 2>&1 | tail -1
  echo -e "${GREEN}[3/4]${NC} Removing unused packages..."
  sudo apt autoremove -y 2>&1 | tail -1
  echo -e "${GREEN}[4/4]${NC} Updating Snap packages..."
  sudo snap refresh 2>/dev/null || echo "  Snap not installed."
  echo ""
  echo -e "${GREEN}  System is up to date!${NC}"
}

show_help() {
  show_banner
  echo -e "${YELLOW}  LGET - Linux Package Manager${NC}"
  echo ""
  echo "  Interactive mode (default):"
  echo "    lget              Browse categories and install packages"
  echo ""
  echo "  Command-line mode:"
  echo "    lget install <pkg> [pkg...]   Install packages"
  echo "    lget remove  <pkg>            Remove a package"
  echo "    lget search  <query>          Search packages"
  echo "    lget search --all             List all packages"
  echo "    lget list                     Show installed packages"
  echo "    lget info    <pkg>            Package details"
  echo "    lget update                   System update"
  echo ""
  echo "  Examples:"
  echo "    lget install firefox vlc code"
  echo "    lget search browser"
  echo "    lget info git"
  echo ""
  echo "  Quick aliases (after install):"
  echo "    lin <pkg>     = lget install"
  echo "    lrm <pkg>     = lget remove"
  echo "    lse <query>   = lget search"
  echo "    ll            = lget list"
  echo "    li <pkg>      = lget info"
  echo "    lup           = lget update"
}

# ═══════════════════════════════════════════════════════════════════════════════
# CLI COMMANDS
# ═══════════════════════════════════════════════════════════════════════════════

cmd_install() {
  [ $# -eq 0 ] && echo -e "${RED}Usage: lget install <pkg> [pkg...]${NC}" && exit 1
  for name in "$@"; do
    entry=$(find_pkg "$name")
    [ -z "$entry" ] && echo -e "${RED}Unknown: $name${NC}" && continue
    install_one "$entry"
  done
}

cmd_remove() {
  [ $# -eq 0 ] && echo -e "${RED}Usage: lget remove <pkg>${NC}" && exit 1
  for name in "$@"; do
    entry=$(find_pkg "$name")
    [ -z "$entry" ] && echo -e "${RED}Unknown: $name${NC}" && continue
    remove_one "$entry"
  done
}

cmd_search() {
  local query="${*:-}"
  if [ "$query" = "--all" ] || [ "$query" = "-a" ]; then
    local last=""
    for entry in "${PKGS[@]}"; do
      IFS='|' read -r name desc cat _ <<< "$entry"
      [ "$cat" != "$last" ] && echo -e "\n${GREEN}--- $cat ---${NC}" && last="$cat"
      printf "  ${CYAN}%-14s${NC} %s\n" "$name" "$desc"
    done
    echo ""
    echo -e "${YELLOW}Total: ${#PKGS[@]} packages${NC}"
    return
  fi
  [ -z "$query" ] && echo -e "${RED}Usage: lget search <query>  or  lget search --all${NC}" && exit 1
  local matches=0 last=""
  echo -e "${CYAN}Search results for '$query':${NC}"
  for entry in "${PKGS[@]}"; do
    IFS='|' read -r name desc cat _ <<< "$entry"
    if echo "$name $desc" | grep -qi "$query"; then
      [ "$cat" != "$last" ] && echo -e "\n${GREEN}--- $cat ---${NC}" && last="$cat"
      printf "  ${CYAN}%-14s${NC} %s\n" "$name" "$desc"
      ((matches++))
    fi
  done
  [ "$matches" -eq 0 ] && echo "  No matches."
  echo -e "\n${YELLOW}$matches matches${NC}"
}

cmd_list() {
  local count=0
  echo -e "${CYAN}Installed packages:${NC}"
  for entry in "${PKGS[@]}"; do
    IFS='|' read -r name desc _ _ <<< "$entry"
    if is_installed "$name"; then
      printf "  ${GREEN}✓${NC} ${CYAN}%-14s${NC} %s\n" "$name" "$desc"
      ((count++))
    fi
  done
  [ "$count" -eq 0 ] && echo "  None installed from database."
  echo -e "\n${YELLOW}$count installed${NC}"
}

cmd_info() {
  [ -z "$1" ] && echo -e "${RED}Usage: lget info <package>${NC}" && exit 1
  entry=$(find_pkg "$1")
  [ -z "$entry" ] && echo -e "${RED}Unknown: $1${NC}" && exit 1
  IFS='|' read -r name desc cat src <<< "$entry"
  IFS=':' read -r stype sval <<< "$src"
  local installed="No"; is_installed "$name" && installed="Yes"
  echo -e "${CYAN}Package:${NC}      $name"
  echo -e "${CYAN}Description:${NC}  $desc"
  echo -e "${CYAN}Category:${NC}     $cat"
  echo -e "${CYAN}Source:${NC}       $stype ($sval)"
  echo -e "${CYAN}Installed:${NC}    $([ "$installed" = "Yes" ] && echo "${GREEN}Yes${NC}" || echo "${RED}No${NC}")"
  [ "$installed" = "Yes" ] && echo -e "${CYAN}Location:${NC}     $(which "$name" 2>/dev/null || echo 'in PATH')"
}

# ═══════════════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════════════

case "${1:-}" in
  install|i)      shift; cmd_install "$@" ;;
  remove|rm|uninstall) shift; cmd_remove "$@" ;;
  search|s|find)  shift; cmd_search "$*" ;;
  list|l)         cmd_list ;;
  info|show)      cmd_info "$2" ;;
  update|up|upgrade) system_update ;;
  help|-h|--help) show_help ;;
  *)              show_main_menu ;;
esac
