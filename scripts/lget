#!/bin/bash
set -euo pipefail

trap 'echo ""; echo "Cancelled."; exit 0' INT TERM

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATA_DIRS=("$SCRIPT_DIR" "/usr/local/share/linux-script" "/usr/local/bin")

for dir in "${DATA_DIRS[@]}"; do
  if [[ -f "$dir/packages.sh" ]]; then
    source "$dir/packages.sh"
    break
  fi
done

if [[ ${#PKGS[@]} -eq 0 ]]; then
  echo "Error: packages.sh not found. Run install.sh first." >&2
  echo "Looked in: ${DATA_DIRS[*]}" >&2
  exit 1
fi

GREEN=$'\e[1;32m'; CYAN=$'\e[1;36m'; YELLOW=$'\e[1;33m'; RED=$'\e[1;31m'; NC=$'\e[0m'

find_pkg() {
  for entry in "${PKGS[@]}"; do
    [[ "${entry%%|*}" == "$1" ]] && echo "$entry" && return 0
  done
  return 1
}

is_installed() {
  local name entry stype sval
  entry=$(find_pkg "$1") || return 1
  IFS='|' read -r _ _ _ src <<< "$entry"
  IFS=':' read -r stype sval <<< "$src"
  case "$stype" in
    apt)   dpkg -s "$sval" 2>/dev/null | grep -q "Status: install ok installed" ;;
    snap|snap-classic) snap list 2>/dev/null | grep -q "^$sval " ;;
    pip)   pip show "$sval" 2>/dev/null | grep -q "Name" ;;
    npm)   npm list -g "$sval" 2>/dev/null | grep -q "$sval" ;;
    script) command -v "$name" &>/dev/null ;;
    *) return 1 ;;
  esac
}

install_with_apt() { sudo apt install -y "$1" 2>&1 | tail -3; return ${PIPESTATUS[0]}; }
install_with_snap() { local p=$1; shift; sudo snap install "$p" "$@" 2>&1 | tail -2; return ${PIPESTATUS[0]}; }

install_script() {
  case "$1" in
    chrome)
      wget -q --show-progress -O /tmp/chrome.deb "https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"
      sudo dpkg -i /tmp/chrome.deb 2>/dev/null; sudo apt install -f -y 2>&1 | tail -5 ;;
    brave)
      sudo curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg 2>/dev/null
      echo "deb [signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main" | sudo tee /etc/apt/sources.list.d/brave-browser-release.list >/dev/null
      sudo apt update -qq && sudo apt install -y brave-browser 2>&1 | tail -5 ;;
    opera)
      wget -q --show-progress -O /tmp/opera.deb "https://download.opera.com/download/get/?partner=www&opsys=Linux"
      sudo dpkg -i /tmp/opera.deb 2>/dev/null; sudo apt install -f -y 2>&1 | tail -5 ;;
    vivaldi)
      wget -q --show-progress -O /tmp/vivaldi.deb "https://downloads.vivaldi.com/stable/vivaldi-stable_amd64.deb"
      sudo dpkg -i /tmp/vivaldi.deb 2>/dev/null; sudo apt install -f -y 2>&1 | tail -5 ;;
    tor-browser) sudo apt install -y torbrowser-launcher 2>&1 | tail -5 ;;
    discord)
      wget -q --show-progress -O /tmp/discord.deb "https://discord.com/api/download?platform=linux&format=deb"
      sudo dpkg -i /tmp/discord.deb 2>/dev/null; sudo apt install -f -y 2>&1 | tail -5 ;;
    zoom)
      wget -q --show-progress -O /tmp/zoom.deb "https://zoom.us/client/latest/zoom_amd64.deb"
      sudo dpkg -i /tmp/zoom.deb 2>/dev/null; sudo apt install -f -y 2>&1 | tail -5 ;;
    spotify)
      curl -sS https://download.spotify.com/debian/pubkey_6224F9941A8AA6D1.gpg | sudo gpg --dearmor --yes -o /etc/apt/trusted.gpg.d/spotify.gpg 2>/dev/null
      echo "deb http://repository.spotify.com stable non-free" | sudo tee /etc/apt/sources.list.d/spotify.list >/dev/null
      sudo apt update -qq && sudo apt install -y spotify-client 2>&1 | tail -5 ;;
    signal)
      wget -qO- https://updates.signal.org/desktop/apt/keys.asc | sudo gpg --dearmor --yes -o /usr/share/keyrings/signal-desktop-keyring.gpg 2>/dev/null
      echo "deb [signed-by=/usr/share/keyrings/signal-desktop-keyring.gpg] https://updates.signal.org/desktop/apt xenial main" | sudo tee /etc/apt/sources.list.d/signal-xenial.list >/dev/null
      sudo apt update -qq && sudo apt install -y signal-desktop 2>&1 | tail -5 ;;
    code)
      wget -q --show-progress -O /tmp/code.deb "https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-x64"
      sudo dpkg -i /tmp/code.deb 2>/dev/null; sudo apt install -f -y 2>&1 | tail -5 ;;
    nodejs)
      curl -fsSL https://deb.nodesource.com/setup_lts.x | sudo -E bash - 2>&1 | tail -3
      sudo apt install -y nodejs 2>&1 | tail -5 ;;
    docker)
      curl -fsSL https://get.docker.com | sh 2>&1 | tail -5
      sudo usermod -aG docker "$USER" 2>/dev/null
      echo "  Log out & back in for Docker group to work." ;;
    rust)
      curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y 2>&1 | tail -5
      echo "  Run: source ~/.cargo/env" ;;
    dotnet)
      wget -q --show-progress -O /tmp/packages-microsoft-prod.deb https://packages.microsoft.com/config/ubuntu/22.04/packages-microsoft-prod.deb
      sudo dpkg -i /tmp/packages-microsoft-prod.deb 2>/dev/null
      sudo apt update -qq && sudo apt install -y dotnet-sdk-8.0 2>&1 | tail -5 ;;
    terraform)
      wget -qO- https://apt.releases.hashicorp.com/gpg | sudo gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg 2>/dev/null
      echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | sudo tee /etc/apt/sources.list.d/hashicorp.list >/dev/null
      sudo apt update -qq && sudo apt install -y terraform 2>&1 | tail -5 ;;
    heroic)
      wget -q --show-progress -O /tmp/heroic.deb "https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher/releases/latest/download/heroic_2.15.2_amd64.deb"
      sudo dpkg -i /tmp/heroic.deb 2>/dev/null; sudo apt install -f -y 2>&1 | tail -5 ;;
    minecraft) sudo apt install -y minecraft-launcher 2>&1 | tail -5 ;;
    foxitreader)
      wget -q --show-progress -O /tmp/foxit.deb "https://cdn01.foxitsoftware.com/pub/foxit/reader/desktop/linux/2.x/2.4/en_us/FoxitReader.2.4.5.0727.x64.deb"
      sudo dpkg -i /tmp/foxit.deb 2>/dev/null; sudo apt install -f -y 2>&1 | tail -5 ;;
    lazydocker)
      curl -fsSL https://raw.githubusercontent.com/jesseduffield/lazydocker/master/scripts/install_update_linux.sh | bash 2>&1 | tail -3 ;;
    *) echo "  No installer for $1"; return 1 ;;
  esac
}

install_one() {
  IFS='|' read -r name desc _ src <<< "$1"
  IFS=':' read -r stype sval <<< "$src"
  printf "  ${GREEN}→${NC} %s ${CYAN}(%s)${NC}\n" "$name" "$desc"
  local status=0
  case "$stype" in
    apt)         install_with_apt "$sval" ;;
    snap)        install_with_snap "$sval" ;;
    snap-classic) install_with_snap "$sval" --classic ;;
    pip)         pip install "$sval" 2>&1 | tail -3 ;;
    npm)         npm install -g "$sval" 2>&1 | tail -3 ;;
    script)      install_script "$name" ;;
    *)           echo "  Unknown type: $stype"; return 1 ;;
  esac
  status=$?
  if [ "$status" -eq 0 ]; then echo -e "  ${GREEN}✓${NC} Installed $name"
  else echo -e "  ${RED}✗${NC} Failed: $name"; fi
  return "$status"
}

remove_one() {
  IFS='|' read -r name _ _ src <<< "$1"
  IFS=':' read -r stype sval <<< "$src"
  echo -n "  Removing $name... "
  case "$stype" in
    apt)   sudo apt remove -y "$sval" &>/dev/null ;;
    snap|snap-classic) sudo snap remove "$sval" &>/dev/null ;;
    pip)   pip uninstall -y "$sval" &>/dev/null ;;
    npm)   npm uninstall -g "$sval" &>/dev/null ;;
    script) echo "manual removal required"; return ;;
  esac; echo "done"
}

cmd_install() {
  local auto_yes=false; local args=()
  for a in "$@"; do [[ "$a" == "-y" || "$a" == "--yes" ]] && auto_yes=true && continue; args+=("$a"); done
  [[ ${#args[@]} -eq 0 ]] && echo "Usage: lget install [-y] <pkg> [pkg...]" && exit 1
  for name in "${args[@]}"; do
    entry=$(find_pkg "$name") || { echo -e "${RED}  Unknown:${NC} $name"; continue; }
    install_one "$entry"
  done
}

cmd_remove() {
  [[ $# -eq 0 ]] && echo "Usage: lget remove <pkg> [pkg...]" && exit 1
  for name in "$@"; do
    entry=$(find_pkg "$name") || { echo -e "${RED}  Unknown:${NC} $name"; continue; }
    remove_one "$entry"
  done
}

cmd_search() {
  local query="${*:-}"
  if [[ "$query" == "--all" || "$query" == "-a" ]]; then
    local last=""
    for entry in "${PKGS[@]}"; do
      IFS='|' read -r name desc cat _ <<< "$entry"
      [[ "$cat" != "$last" ]] && echo -e "\n${GREEN}${cat}${NC}" && last="$cat"
      printf "  ${CYAN}%-14s${NC} %s\n" "$name" "$desc"
    done
    echo -e "\n${GREEN}Total:${NC} ${#PKGS[@]} packages"; return
  fi
  [[ -z "$query" ]] && echo "Usage: lget search <query>  or  lget search --all" && exit 1
  local matches=0 last=""
  echo -e "${GREEN}Search:${NC} $query"
  for entry in "${PKGS[@]}"; do
    IFS='|' read -r name desc cat _ <<< "$entry"
    if echo "$name $desc" | grep -qi "$query"; then
      [[ "$cat" != "$last" ]] && echo -e "\n${GREEN}${cat}${NC}" && last="$cat"
      printf "  ${CYAN}%-14s${NC} %s\n" "$name" "$desc"
      matches=$((matches + 1))
    fi
  done
  [[ $matches -eq 0 ]] && echo "  No matches."
  echo -e "\n${YELLOW}$matches matches${NC}"
}

cmd_list() {
  local count=0
  echo -e "${GREEN}Installed packages:${NC}"
  for entry in "${PKGS[@]}"; do
    IFS='|' read -r name desc _ _ <<< "$entry"
    if is_installed "$name"; then
      printf "  ${GREEN}✓${NC} ${CYAN}%-14s${NC} %s\n" "$name" "$desc"
      count=$((count + 1))
    fi
  done
  [[ $count -eq 0 ]] && echo "  None installed from database."
  echo -e "\n${YELLOW}$count installed${NC}"
}

cmd_info() {
  [[ -z "${1:-}" ]] && echo "Usage: lget info <package>" && exit 1
  entry=$(find_pkg "$1") || { echo -e "${RED}Unknown:${NC} $1"; exit 1; }
  IFS='|' read -r name desc cat src <<< "$entry"
  IFS=':' read -r stype sval <<< "$src"
  local installed=$(is_installed "$name" && echo "${GREEN}Yes${NC}" || echo "${RED}No${NC}")
  echo -e "${CYAN}Package:${NC}     $name"
  echo -e "${CYAN}Description:${NC} $desc"
  echo -e "${CYAN}Category:${NC}    $cat"
  echo -e "${CYAN}Source:${NC}      $stype ($sval)"
  echo -e "${CYAN}Installed:${NC}   $installed"
}

cmd_update() {
  echo -e "${YELLOW}System Update${NC}"
  echo -e "${GREEN}[1/4]${NC} APT update..."; sudo apt update -qq
  echo -e "${GREEN}[2/4]${NC} APT upgrade..."; sudo apt upgrade -y 2>&1 | tail -5
  echo -e "${GREEN}[3/4]${NC} APT autoremove..."; sudo apt autoremove -y 2>&1 | tail -3
  echo -e "${GREEN}[4/4]${NC} Snap refresh..."; sudo snap refresh 2>/dev/null || true
  echo -e "${GREEN}System updated.${NC}"
}

# ─── WHIPTAIL INTERACTIVE ──────────────────────────────────────────────

can_whiptail() {
  [[ -t 0 ]] || return 1
  command -v whiptail &>/dev/null || return 1
  tput lines &>/dev/null || return 1
  tput cols &>/dev/null || return 1
  [ "$(tput lines)" -ge 14 ] && [ "$(tput cols)" -ge 50 ]
}

wrun() {
  local tmp; tmp=$(mktemp /tmp/lget_w.XXXXXX 2>/dev/null) || return 1
  whiptail "$@" >"$tmp"; local ret=$?; local val
  val=$(<"$tmp" 2>/dev/null); rm -f "$tmp"; printf '%s' "$val"; return "$ret"
}

whiptail_install_pkgs() {
  local names=("$@")
  local summary=""
  for n in "${names[@]}"; do
    local e=$(find_pkg "$n")
    IFS='|' read -r _ d _ _ <<< "$e"
    summary+="$n - $d\n"
  done
  whiptail --title "Confirm Installation" --yesno "Install ${#names[@]} package(s)?\n\n$summary\nProceed?" 16 60 || return 1
  clear
  for n in "${names[@]}"; do
    local e=$(find_pkg "$n") && install_one "$e"
  done
  echo -e "\n${GREEN}Done.${NC}"
  read -p "Press Enter..."
}

whiptail_category_menu() {
  local cats=(); mapfile -t cats < <(get_categories)
  while true; do
    local args=()
    for c in "${cats[@]}"; do args+=("$c" "$(get_cat_count "$c") packages"); done
    args+=("SEARCH" "Search all packages" "INSTALLED" "Show installed" "UPDATE" "System update" "HELP" "Help")
    local ch
    ch=$(wrun --title "LGET - Package Browser" --menu "↑↓ navigate  ENTER select  ESC exit" 20 58 14 "${args[@]}") || return
    case "$ch" in
      SEARCH) whiptail_search ;;
      INSTALLED) whiptail_installed ;;
      UPDATE) whiptail_update ;;
      HELP) whiptail --title "LGET - Help" --msgbox "LGET - Linux Package Manager\n\nBrowse categories → Space to toggle packages → Enter to confirm\n\nCLI:\nlget install <pkg>\nlget remove <pkg>\nlget search <query>\nlget list\nlget info <pkg>\nlget update" 18 60 ;;
      *) [ -n "$ch" ] && whiptail_checklist "$ch" ;;
    esac
  done
}

whiptail_checklist() {
  local cat="$1"; local entries=()
  mapfile -t entries < <(get_pkgs_by_cat "$cat")
  local args=()
  local h=$((${#entries[@]} + 8)); [ "$h" -gt 20 ] && h=20; [ "$h" -lt 10 ] && h=10
  for e in "${entries[@]}"; do
    IFS='|' read -r n d _ _ <<< "$e"
    local ch="OFF"; is_installed "$n" && ch="ON"
    args+=("$n" "$d" "$ch")
  done
  local result
  result=$(wrun --title "LGET - $cat (SPACE=toggle, ENTER=install)" --checklist "↑↓ arrows  SPACE toggle  ENTER confirm" "$h" 70 "${#entries[@]}" "${args[@]}") || return
  local sel=(); eval "sel=($result)"; [ ${#sel[@]} -eq 0 ] && return
  whiptail_install_pkgs "${sel[@]}"
}

whiptail_search() {
  local q; q=$(wrun --title "Search" --inputbox "Search term:" 8 60) || return; [ -z "$q" ] && return
  local matches=(); local descs=()
  for e in "${PKGS[@]}"; do
    IFS='|' read -r n d c _ <<< "$e"
    if echo "$n $d" | grep -qi "$q"; then matches+=("$n"); descs+=("$n - $d [$c]"); fi
  done
  [ ${#matches[@]} -eq 0 ] && whiptail --title "No Results" --msgbox "No matches for: $q" 8 50 && return
  local args=()
  for i in "${!matches[@]}"; do args+=("${matches[$i]}" "${descs[$i]}" "OFF"); done
  local result
  result=$(wrun --title "Results (${#matches[@]})" --checklist "SPACE=toggle  ENTER=install" 18 70 10 "${args[@]}") || return
  local sel=(); eval "sel=($result)"; [ ${#sel[@]} -eq 0 ] && return
  whiptail_install_pkgs "${sel[@]}"
}

whiptail_installed() {
  local list=""; local c=0
  for e in "${PKGS[@]}"; do
    IFS='|' read -r n d _ _ <<< "$e"
    if is_installed "$n"; then list+="  $n - $d\n"; c=$((c + 1)); fi
  done
  [ "$c" -eq 0 ] && list="No packages installed."
  whiptail --title "Installed" --msgbox "Total: $c\n\n$list" 20 70
}

whiptail_update() {
  (echo "XXX"; echo "0"; echo "APT update..."; echo "XXX"; sudo apt update -qq
   echo "XXX"; echo "40"; echo "Upgrading..."; echo "XXX"; sudo apt upgrade -y 2>&1 | tail -5
   echo "XXX"; echo "75"; echo "Autoremove..."; echo "XXX"; sudo apt autoremove -y 2>&1 | tail -3
   echo "XXX"; echo "90"; echo "Snap refresh..."; echo "XXX"; sudo snap refresh 2>/dev/null || true
   echo "XXX"; echo "100"; echo "Done!"; echo "XXX") | whiptail --title "System Update" --gauge "Starting..." 8 60 0
}

# ─── TEXT INTERACTIVE (fallback) ───────────────────────────────────────

get_categories() {
  local cats=()
  for entry in "${PKGS[@]}"; do
    IFS='|' read -r _ _ cat _ <<< "$entry"
    local found=false
    for c in "${cats[@]}"; do [[ "$c" == "$cat" ]] && found=true && break; done
    $found || cats+=("$cat")
  done
  printf '%s\n' "${cats[@]}"
}

get_pkgs_by_cat() {
  local cat="$1"
  for entry in "${PKGS[@]}"; do
    IFS='|' read -r name desc cat2 _ <<< "$entry"
    [[ "$cat2" == "$cat" ]] && echo "$entry"
  done
}

get_cat_count() {
  local cat="$1" c=0
  for entry in "${PKGS[@]}"; do
    IFS='|' read -r _ _ c2 _ <<< "$entry"
    [[ "$c2" == "$cat" ]] && c=$((c + 1))
  done
  echo "$c"
}

text_menu() {
  local cats=(); mapfile -t cats < <(get_categories)
  while true; do
    printf "\033[2J\033[H"
    echo -e "${GREEN}┌─────────────────────────────────────────────────────┐${NC}"
    echo -e "${GREEN}│              LGET - Package Browser                 │${NC}"
    echo -e "${GREEN}└─────────────────────────────────────────────────────┘${NC}"
    echo ""
    for i in $(seq 0 $((${#cats[@]} - 1))); do
      printf "  [${GREEN}%d${NC}]  ${CYAN}%-22s${NC} ${YELLOW}(%d)${NC}\n" $((i+1)) "${cats[$i]}" "$(get_cat_count "${cats[$i]}")"
    done
    echo ""
    echo -e "  [${GREEN}s${NC}] Search  [${GREEN}i${NC}] Installed  [${GREEN}u${NC}] Update  [${GREEN}q${NC}] Quit"
    read -p "  Choice: " ch
    case "$ch" in
      q|Q) printf "\033[2J\033[H"; exit 0 ;;
      u|U) cmd_update; read -p "Press Enter..." ;;
      i|I) cmd_list; read -p "Press Enter..." ;;
      s|S) read -p "  Search: " q; [ -n "$q" ] && cmd_search "$q"; read -p "Press Enter..." ;;
      *)
        if [ "$ch" -ge 1 ] 2>/dev/null && [ "$ch" -le "${#cats[@]}" ] 2>/dev/null; then
          text_browse "${cats[$((ch-1))]}"
        fi ;;
    esac
  done
}

text_browse() {
  local cat="$1"; local entries=(); mapfile -t entries < <(get_pkgs_by_cat "$cat")
  while true; do
    printf "\033[2J\033[H"
    echo -e "${YELLOW}${cat}${NC} ${CYAN}[${#entries[@]} packages]${NC}\n"
    for i in $(seq 0 $((${#entries[@]} - 1))); do
      IFS='|' read -r n d _ _ <<< "${entries[$i]}"
      local m=" "; is_installed "$n" && m="${GREEN}✓${NC}"
      printf "  %s [%2d] ${CYAN}%-16s${NC} %s\n" "$m" $((i+1)) "$n" "$d"
    done
    echo -e "\n  ${YELLOW}Numbers to install (e.g. 1 3 5-8)${NC}"
    echo -e "  ${GREEN}[b]${NC} Back  ${GREEN}[q]${NC} Quit"
    read -p "  Choice: " input
    [[ "$input" == "q" ]] && { printf "\033[2J\033[H"; exit 0; }
    [[ "$input" == "b" ]] && return
    local sel=()
    for part in $input; do
      if echo "$part" | grep -qE '^[0-9]+-[0-9]+$'; then
        local s="${part%-*}" e="${part#*-}"
        for n in $(seq "$s" "$e"); do [ "$n" -ge 1 ] && [ "$n" -le "${#entries[@]}" ] && sel+=("$n"); done
      elif [ "$part" -ge 1 ] 2>/dev/null && [ "$part" -le "${#entries[@]}" ] 2>/dev/null; then sel+=("$part"); fi
    done
    [ ${#sel[@]} -eq 0 ] && continue
    local names=()
    for n in "${sel[@]}"; do IFS='|' read -r name _ _ _ <<< "${entries[$((n-1))]}"; names+=("$name"); done
    echo ""; echo -e "${YELLOW}Install:${NC} ${names[*]}"
    read -p "  Proceed? [y/N]: " cf
    [[ "$cf" =~ ^[yY] ]] || continue
    for name in "${names[@]}"; do entry=$(find_pkg "$name") && install_one "$entry"; done
    read -p "Press Enter..."
  done
}

show_help() {
  echo -e "${GREEN}lget${NC} - Linux Package Manager"
  echo ""
  echo "Usage:"
  echo "  lget                          Show help (this screen)"
  echo "  lget menu                     Interactive package browser"
  echo "  lget install [-y] <pkg>...    Install packages"
  echo "  lget remove  <pkg>...         Remove packages"
  echo "  lget search  <query>          Search packages"
  echo "  lget search --all             List every package"
  echo "  lget list                     Show installed packages"
  echo "  lget info    <pkg>            Package details"
  echo "  lget update                   System update"
  echo "  lget upgrade                  Alias for update"
  echo "  lget help                     Show this help"
  echo ""
  echo "Aliases: lin, lrm, lse, ll, li, lup"
  echo -e "${YELLOW}${#PKGS[@]} packages available${NC}"
}

case "${1:-}" in
  install|i)      shift; cmd_install "$@" ;;
  remove|rm|uninstall) shift; cmd_remove "$@" ;;
  search|s|find)  shift; cmd_search "$*" ;;
  list|l)         cmd_list ;;
  info|show)      shift; cmd_info "${1:-}" ;;
  update|up)      cmd_update ;;
  upgrade)        cmd_upgrade ;;
  help|-h|--help) show_help ;;
  "menu")
    if can_whiptail; then
      whiptail_category_menu
    else
      text_menu
    fi
    ;;
  "")
    if [[ -t 0 ]]; then
      if can_whiptail; then
        whiptail_category_menu
      else
        text_menu
      fi
    else
      echo -e "${GREEN}lget${NC} - ${#PKGS[@]} packages available."
      echo "Run 'lget menu' for interactive browser, or 'lget help' for usage."
    fi
    ;;
  *)
    echo -e "${RED}Unknown command:${NC} $1"
    show_help; exit 1
    ;;
esac
