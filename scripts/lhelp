#!/bin/bash

GREEN=$'\e[1;32m'; CYAN=$'\e[1;36m'; YELLOW=$'\e[1;33m'; RED=$'\e[1;31m'; NC=$'\e[0m'

show_lget_help() {
  echo -e "${GREEN}lget${NC} - Linux Package Manager"
  echo ""
  echo "Usage:"
  echo "  lget install <pkg> [pkg...]   Install packages"
  echo "  lget remove  <pkg> [pkg...]   Remove packages"
  echo "  lget search  <query>          Search packages"
  echo "  lget search --all             List every package"
  echo "  lget list                     Show installed packages"
  echo "  lget info    <pkg>            Package details"
  echo "  lget update                   System update"
  echo "  lget upgrade                  Alias for update"
  echo ""
  echo "Aliases:"
  echo "  lin <pkg>   = lget install"
  echo "  lrm <pkg>   = lget remove"
  echo "  lse <query> = lget search"
  echo "  ll          = lget list"
  echo "  li <pkg>    = lget info"
  echo "  lup         = lget update"
  echo ""
  echo "Categories: Browsers, Media & Graphics, Communication,"
  echo "            Development, Utilities, Gaming, Security,"
  echo "            Productivity, Tools"
  echo "Packages: 150+"
}

show_ltool_help() {
  echo -e "${GREEN}ltool${NC} - Linux System Toolkit"
  echo ""
  echo "Usage:"
  echo "  ltool update     System update & cleanup"
  echo "  ltool info       System information"
  echo "  ltool clean      Deep system cleanup"
  echo "  ltool dev        Install dev stack"
  echo "  ltool media      Install media tools"
  echo "  ltool gaming     Install gaming tools"
  echo ""
  echo "Quick stacks call lget internally."
}

show_examples() {
  echo -e "${GREEN}Examples${NC}"
  echo ""
  echo "  lget install firefox vlc code     Install multiple packages"
  echo "  lget search browser               Search packages"
  echo "  lget list                         Show installed"
  echo "  lget info git                     Package details"
  echo "  lget update                       System update"
  echo "  ltool dev                         One-command dev setup"
  echo "  ltool info                        System information"
}

case "${1:-}" in
  lget|package|pkg)
    show_lget_help ;;
  ltool|tool|system)
    show_ltool_help ;;
  example|examples|ex)
    show_examples ;;
  all|""|-a|--all)
    show_lget_help; echo ""; show_ltool_help; echo ""; show_examples ;;
  *)
    echo -e "${RED}Unknown:${NC} $1"
    echo "Usage: lhelp [lget|ltool|examples|all]"
    echo ""; show_lget_help ;;
esac
