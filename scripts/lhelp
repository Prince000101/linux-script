#!/bin/bash

CYAN='\033[1;36m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'; RED='\033[1;31m'; NC='\033[0m'

echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║           Linux Script - Help / Overview                    ║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
echo ""

echo -e "${YELLOW}LGET${NC}  - Interactive package manager (Chocolatey-like)"
echo ""
echo "  Run ${GREEN}lget${NC} to open the interactive menu where you can:"
echo "    - Browse 150+ packages organized in 9 categories"
echo "    - Select multiple packages to install at once"
echo "    - Search for packages"
echo "    - See what's installed"
echo "    - Run system update"
echo ""
echo -e "${YELLOW}  Categories:${NC}"
echo "    Browsers | Media & Graphics | Communication"
echo "    Development | Utilities | Gaming | Security"
echo "    Productivity | Tools"
echo ""
echo -e "${YELLOW}  CLI commands (for power users):${NC}"
echo ""
printf "    ${GREEN}%-20s${NC} %s\n" "lget" "Open interactive menu"
printf "    ${GREEN}%-20s${NC} %s\n""lget install <pkg>" "Install a package"
printf "    ${GREEN}%-20s${NC} %s\n" "lget remove <pkg>" "Remove a package"
printf "    ${GREEN}%-20s${NC} %s\n" "lget search <query>" "Search packages"
printf "    ${GREEN}%-20s${NC} %s\n" "lget search --all" "Show every package"
printf "    ${GREEN}%-20s${NC} %s\n" "lget list" "Show installed"
printf "    ${GREEN}%-20s${NC} %s\n" "lget info <pkg>" "Package details"
printf "    ${GREEN}%-20s${NC} %s\n" "lget update" "System update"
echo ""

echo -e "${YELLOW}LTOOL${NC}  - System toolkit"
echo ""
printf "    ${GREEN}%-20s${NC} %s\n" "ltool" "Interactive toolkit menu"
printf "    ${GREEN}%-20s${NC} %s\n" "ltool update" "System update & cleanup"
printf "    ${GREEN}%-20s${NC} %s\n" "ltool info" "System information"
printf "    ${GREEN}%-20s${NC} %s\n" "ltool dev" "Install dev stack"
printf "    ${GREEN}%-20s${NC} %s\n" "ltool media" "Install media tools"
printf "    ${GREEN}%-20s${NC} %s\n" "ltool gaming" "Install gaming tools"
echo ""

echo -e "${YELLOW}EXAMPLES${NC}"
echo ""
echo "  ${GREEN}lget${NC}"
echo "    -> Opens interactive menu. Pick a category, pick packages, install."
echo ""
echo "  ${GREEN}lget install firefox vlc code${NC}"
echo "    -> CLI: install Firefox, VLC, and VS Code in one command."
echo ""
echo "  ${GREEN}lget search browser${NC}"
echo "    -> CLI: find all browser-related packages."
echo ""

echo -e "${YELLOW}ALIASES${NC}"
echo ""
printf "    ${GREEN}%-10s${NC} = ${CYAN}lget install${NC}\n" "lin"
printf "    ${GREEN}%-10s${NC} = ${CYAN}lget remove${NC}\n" "lrm"
printf "    ${GREEN}%-10s${NC} = ${CYAN}lget search${NC}\n" "lse"
printf "    ${GREEN}%-10s${NC} = ${CYAN}lget list${NC}\n" "ll"
printf "    ${GREEN}%-10s${NC} = ${CYAN}lget info${NC}\n" "li"
printf "    ${GREEN}%-10s${NC} = ${CYAN}lget update${NC}\n" "lup"
echo ""

echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║   GitHub: github.com/Prince000101/linux-script              ║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
