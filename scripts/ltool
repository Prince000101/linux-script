#!/bin/bash

CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m'

show_help() {
  echo -e "${CYAN}ltool${NC} - Linux Toolkit"
  echo ""
  echo "Usage:"
  echo "  ltool                   Interactive menu"
  echo "  ltool update            Run system update & cleanup"
  echo "  ltool info              Show system information"
  echo "  ltool dev               Install development stack"
  echo "  ltool media             Install media tools"
  echo "  ltool gaming            Install gaming tools"
  echo "  ltool -h|--help         Show this help"
  exit 0
}

[ "$1" = "-h" ] || [ "$1" = "--help" ] && show_help

system_update() {
  echo -e "${YELLOW}System Update & Cleanup${NC}"
  echo ""
  sudo apt update
  sudo apt upgrade -y
  sudo apt autoremove -y
  sudo apt autoclean
  sudo snap refresh 2>/dev/null
  echo ""
  echo -e "${GREEN}System is up to date.${NC}"
  read -p "Press Enter..."
}

system_info() {
  echo -e "${CYAN}System Information${NC}"
  echo ""
  echo -e "${GREEN}Hostname:${NC}    $(hostname)"
  echo -e "${GREEN}Kernel:${NC}      $(uname -r)"
  echo -e "${GREEN}OS:${NC}          $(lsb_release -ds 2>/dev/null || cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d= -f2 | tr -d '\"')"
  echo -e "${GREEN}CPU:${NC}         $(lscpu | grep 'Model name' | head -1 | cut -d: -f2 | xargs)"
  echo -e "${GREEN}Memory:${NC}      $(free -h | awk '/^Mem:/ {print $3 "/" $2}')"
  echo -e "${GREEN}Disk:${NC}        $(df -h / | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}')"
  echo -e "${GREEN}Uptime:${NC}      $(uptime -p | sed 's/up //')"
  echo ""
  read -p "Press Enter..."
}

install_dev_stack() {
  echo -e "${YELLOW}Installing Development Stack${NC}"
  echo ""
  echo -e "${GREEN}[1/6]${NC} Git..."
  sudo apt install -y git 2>&1 | tail -1
  echo -e "${GREEN}[2/6]${NC} Build essentials..."
  sudo apt install -y build-essential 2>&1 | tail -1
  echo -e "${GREEN}[3/6]${NC} Python 3 + pip..."
  sudo apt install -y python3 python3-pip 2>&1 | tail -1
  echo -e "${GREEN}[4/6]${NC} Node.js (LTS)..."
  if ! command -v node &>/dev/null; then
    curl -fsSL https://deb.nodesource.com/setup_lts.x | sudo -E bash - 2>&1 | tail -1
    sudo apt install -y nodejs 2>&1 | tail -1
  else
    echo "  Node.js already installed ($(node -v))"
  fi
  echo -e "${GREEN}[5/6]${NC} Docker..."
  if ! command -v docker &>/dev/null; then
    curl -fsSL https://get.docker.com | sh 2>&1 | tail -1
    sudo usermod -aG docker "$USER" 2>/dev/null
  else
    echo "  Docker already installed"
  fi
  echo -e "${GREEN}[6/6]${NC} VS Code..."
  if ! command -v code &>/dev/null; then
    wget -q --show-progress -O /tmp/code.deb "https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-x64"
    sudo dpkg -i /tmp/code.deb 2>/dev/null
    sudo apt install -f -y 2>&1 | tail -1
  else
    echo "  VS Code already installed"
  fi
  echo ""
  echo -e "${GREEN}Development stack installed!${NC}"
  echo -e "${YELLOW}Note: Log out and back in for Docker group to take effect.${NC}"
  read -p "Press Enter..."
}

install_media_tools() {
  echo -e "${YELLOW}Installing Media Tools${NC}"
  echo ""
  sudo apt install -y ffmpeg vlc mpv gimp audacity 2>&1 | tail -1
  pip install yt-dlp 2>&1 | tail -1
  echo ""
  echo -e "${GREEN}Media tools installed.${NC}"
  read -p "Press Enter..."
}

install_gaming() {
  echo -e "${YELLOW}Installing Gaming Tools${NC}"
  echo ""
  sudo apt install -y steam lutris 2>&1 | tail -1
  echo ""
  echo -e "${GREEN}Gaming tools installed.${NC}"
  read -p "Press Enter..."
}

setup_lget_completions() {
  echo -e "${YELLOW}Setting up lget bash completions...${NC}"
  local names=()
  for entry in "${PACKAGES[@]}"; do
    IFS='|' read -r pkg_name _ <<< "$entry"
    names+=("$pkg_name")
  done
  local completions_dir="/etc/bash_completion.d"
  if [ -d "$completions_dir" ]; then
    sudo tee "$completions_dir/lget" >/dev/null <<EOF
_lget_completions() {
  local cur=\${COMP_WORDS[COMP_CWORD]}
  local prev=\${COMP_WORDS[COMP_CWORD-1]}
  local commands="install remove search list info update help"
  local packages="${names[*]}"
  case \$prev in
    install|remove|info)
      COMPREPLY=(\$(compgen -W "\$packages" -- \$cur))
      ;;
    *)
      COMPREPLY=(\$(compgen -W "\$commands" -- \$cur))
      ;;
  esac
}
complete -F _lget_completions lget
EOF
    echo -e "${GREEN}  Bash completions installed (restart shell to use).${NC}"
  fi
}

case "$1" in
  update|upgrade)
    system_update
    ;;
  info|sysinfo)
    system_info
    ;;
  dev|development|devstack)
    install_dev_stack
    ;;
  media)
    install_media_tools
    ;;
  gaming)
    install_gaming
    ;;
  ""|menu)
    while true; do
      clear
      echo -e "${CYAN}========================================${NC}"
      echo -e "${GREEN}      LTOOL - Linux Toolkit             ${NC}"
      echo -e "${CYAN}========================================${NC}"
      echo ""
      echo " 1) System Update & Cleanup"
      echo " 2) System Information"
      echo " 3) Install Development Stack"
      echo " 4) Install Media Tools"
      echo " 5) Install Gaming Tools"
      echo " 6) Exit"
      echo ""
      read -p "Choice [1-6]: " CHOICE

      case $CHOICE in
        1) system_update ;;
        2) system_info ;;
        3) install_dev_stack ;;
        4) install_media_tools ;;
        5) install_gaming ;;
        6) exit 0 ;;
        *) read -p "Invalid. Press Enter..." ;;
      esac
    done
    ;;
  -h|--help)
    show_help
    ;;
  *)
    echo -e "${RED}Unknown option: $1${NC}"
    show_help
    ;;
esac
