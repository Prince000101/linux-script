#!/bin/bash
set -euo pipefail

GREEN=$'\e[1;32m'; CYAN=$'\e[1;36m'; YELLOW=$'\e[1;33m'; RED=$'\e[1;31m'; NC=$'\e[0m'

cmd_update() {
  echo -e "${YELLOW}System Update & Cleanup${NC}"
  echo -e "${GREEN}[1/5]${NC} APT update..."
  sudo apt update -qq
  echo -e "${GREEN}[2/5]${NC} APT upgrade..."
  sudo apt upgrade -y 2>&1 | tail -5
  echo -e "${GREEN}[3/5]${NC} APT autoremove..."
  sudo apt autoremove -y 2>&1 | tail -3
  echo -e "${GREEN}[4/5]${NC} APT autoclean..."
  sudo apt autoclean 2>&1 | tail -2
  echo -e "${GREEN}[5/5]${NC} Snap refresh..."
  sudo snap refresh 2>/dev/null || echo "  Snap not installed."
  echo -e "${GREEN}System updated.${NC}"
}

cmd_info() {
  local OUT
  OUT="Hostname:     $(hostname)\n"
  OUT+="Kernel:       $(uname -r)\n"
  OUT+="OS:           $(lsb_release -ds 2>/dev/null || grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '\"')\n"
  OUT+="Uptime:       $(uptime -p | sed 's/up //')\n"
  OUT+="Shell:        $(basename "$SHELL")\n"
  OUT+="Packages:     $(dpkg -l 2>/dev/null | grep -c '^ii') apt / $(snap list 2>/dev/null | wc -l) snap\n"
  OUT+="\n-- CPU --\n"
  OUT+="Model:        $(lscpu | grep 'Model name' | head -1 | cut -d: -f2 | xargs)\n"
  OUT+="Cores:        $(nproc)\n"
  OUT+="\n-- Memory --\n"
  OUT+="RAM:          $(free -h | awk '/^Mem:/ {print $3 " / " $2}')\n"
  OUT+="Swap:         $(free -h | awk '/^Swap:/ {print $3 " / " $2}')\n"
  OUT+="\n-- Disk --\n"
  OUT+="Root:         $(df -h / | awk 'NR==2 {print $3 " / " $2 " (" $5 " used)"}')\n"
  OUT+="\n-- Network --\n"
  OUT+="IP:           $(ip -4 addr show | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '127.0.0.1' | head -1 || echo 'N/A')\n"
  OUT+="Gateway:      $(ip route | grep default | awk '{print $3}' || echo 'N/A')\n"
  OUT+="DNS:          $(grep -oP '(?<=nameserver\s)\S+' /etc/resolv.conf 2>/dev/null | head -3 | tr '\n' ' ' || echo 'N/A')"

  echo -e "${CYAN}System Information${NC}\n"
  echo -e "$OUT"
}

cmd_clean() {
  echo -e "${YELLOW}System Deep Cleanup${NC}"
  echo -e "${GREEN}[1/6]${NC} APT clean..."
  sudo apt clean 2>&1 | tail -2
  echo -e "${GREEN}[2/6]${NC} Journal logs (older than 7 days)..."
  sudo journalctl --vacuum-time=7d 2>&1 | tail -2
  echo -e "${GREEN}[3/6]${NC} /tmp files..."
  sudo rm -rf /tmp/* 2>/dev/null
  echo -e "${GREEN}[4/6]${NC} Thumbnail cache..."
  rm -rf "$HOME/.cache/thumbnails/"* 2>/dev/null
  echo -e "${GREEN}[5/6]${NC} Old snap revisions..."
  snap list --all 2>/dev/null | awk '/disabled/{print $1, $3}' | while read -r name rev; do
    sudo snap remove "$name" --revision="$rev" 2>/dev/null
  done
  echo -e "${GREEN}[6/6]${NC} Package cache..."
  sudo apt clean 2>&1 | tail -1
  echo -e "${GREEN}Cleanup complete.${NC}"
}

cmd_dev() {
  echo -e "${YELLOW}Installing Development Stack${NC}"
  for pkg in git build-essential python3 python3-pip nodejs docker code gh make gcc; do
    echo -e "${GREEN}  →${NC} $pkg..."
    lget install "$pkg" 2>/dev/null || true
  done
  echo -e "${GREEN}Development stack done.${NC}"
}

cmd_media() {
  echo -e "${YELLOW}Installing Media Tools${NC}"
  for pkg in ffmpeg vlc mpv gimp audacity inkscape obs-studio flameshot yt-dlp; do
    echo -e "${GREEN}  →${NC} $pkg..."
    lget install "$pkg" 2>/dev/null || true
  done
  echo -e "${GREEN}Media tools done.${NC}"
}

cmd_gaming() {
  echo -e "${YELLOW}Installing Gaming Tools${NC}"
  for pkg in steam lutris wine winetricks gamemode mangohud; do
    echo -e "${GREEN}  →${NC} $pkg..."
    lget install "$pkg" 2>/dev/null || true
  done
  echo -e "${GREEN}Gaming tools done.${NC}"
}

show_help() {
  echo -e "${GREEN}ltool${NC} - Linux System Toolkit"
  echo ""
  echo "Usage:"
  echo "  ltool update     System update & cleanup"
  echo "  ltool info       System information"
  echo "  ltool clean      Deep system cleanup"
  echo "  ltool dev        Install dev stack"
  echo "  ltool media      Install media tools"
  echo "  ltool gaming     Install gaming tools"
  echo "  ltool help       Show this help"
  echo ""
  echo "  lget (no args)   Interactive package browser"
  echo "Quick stacks call lget internally."
}

case "${1:-}" in
  update|upgrade)   cmd_update ;;
  info|sysinfo)     cmd_info ;;
  clean|cleanup)    cmd_clean ;;
  dev|development)  cmd_dev ;;
  media)            cmd_media ;;
  gaming)           cmd_gaming ;;
  help|-h|--help|"") show_help ;;
  *)
    echo -e "${RED}Unknown:${NC} $1"
    show_help
    exit 1
    ;;
esac
